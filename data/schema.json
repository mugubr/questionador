{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://profnit.local/questionador/schema.json",
  "title": "Banco de questões PROFNIT",
  "type": "object",
  "required": ["versao", "provas", "questoes"],
  "additionalProperties": false,
  "properties": {
    "versao": {
      "type": "integer",
      "const": 1,
      "description": "Versão do formato do banco. O app rejeita versões que não conhece."
    },
    "geradoEm": {
      "type": "string",
      "description": "Data de geração no formato AAAA-MM-DD."
    },
    "provas": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "titulo", "temGabaritoOficial"],
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[A-Z0-9-]+$",
            "description": "Identificador curto, ex.: ENA26, AV2-PI."
          },
          "titulo": { "type": "string", "minLength": 1 },
          "data": {
            "type": "string",
            "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
            "description": "Data de aplicação da prova."
          },
          "arquivo": {
            "type": "string",
            "description": "PDF de origem em Provas/."
          },
          "temGabaritoOficial": { "type": "boolean" }
        }
      }
    },
    "questoes": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/questao" }
    }
  },
  "$defs": {
    "letra": { "type": "string", "enum": ["a", "b", "c", "d"] },
    "questao": {
      "type": "object",
      "required": ["id", "prova", "numero", "tema", "enunciado", "alternativas", "resposta"],
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[A-Z0-9-]+-Q\\d{2}$",
          "description": "Ex.: ENA26-Q01."
        },
        "prova": {
          "type": "string",
          "description": "Deve corresponder ao id de uma entrada de provas[]."
        },
        "numero": { "type": "integer", "minimum": 1, "maximum": 99 },
        "tema": {
          "type": "string",
          "minLength": 1,
          "description": "Chave de agrupamento usada no filtro por tema."
        },
        "enunciado": {
          "type": "string",
          "minLength": 10,
          "description": "Texto completo, com quebras de linha significativas preservadas."
        },
        "alternativas": {
          "type": "object",
          "required": ["a", "b", "c", "d"],
          "additionalProperties": false,
          "properties": {
            "a": { "type": "string", "minLength": 1 },
            "b": { "type": "string", "minLength": 1 },
            "c": { "type": "string", "minLength": 1 },
            "d": { "type": "string", "minLength": 1 }
          }
        },
        "resposta": {
          "type": "object",
          "required": ["letra", "procedencia"],
          "additionalProperties": false,
          "properties": {
            "letra": { "$ref": "#/$defs/letra" },
            "procedencia": { "type": "string", "enum": ["oficial", "derivada"] },
            "confianca": { "type": "string", "enum": ["alta", "media", "baixa"] },
            "referencia": { "type": "string", "minLength": 1 },
            "justificativa": { "type": "string", "minLength": 1 }
          },
          "allOf": [
            {
              "if": { "properties": { "procedencia": { "const": "derivada" } } },
              "then": { "required": ["letra", "procedencia", "confianca", "referencia", "justificativa"] }
            },
            {
              "if": { "properties": { "procedencia": { "const": "oficial" } } },
              "then": {
                "not": {
                  "anyOf": [
                    { "required": ["confianca"] },
                    { "required": ["justificativa"] }
                  ]
                }
              }
            }
          ]
        }
      }
    }
  }
}
